{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vagvat-payment-api",
  "main": "index.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": false,
  "routes": [
    { "pattern": "api.vagvatayurveda.com/*", "zone_name": "vagvatayurveda.com" }
  ],
  "limits": { "cpu_ms": 10 },
  "triggers": { "crons": ["0 3 * * *"] },
  "d1_databases": [
    {
      "binding": "CHECKOUT_DB",
      "database_name": "vagvat-checkout",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "vagvat-98c70"
  }
}
