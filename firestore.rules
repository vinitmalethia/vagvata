rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user is the designated Vaidya administrator
    function isAdmin() {
      return request.auth != null && request.auth.uid == '3KIdtkNrZSTLd5iqRGxLLG7UihA2';
    }

    // Orders Collection: Central synchronized order collection
    match /orders/{orderId} {
      // 1. Customers can create orders during checkout
      allow create: if request.resource.data.orderId == orderId
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 1
                    && request.resource.data.customerEmail is string
                    && request.resource.data.total is number
                    && request.resource.data.total >= 0
                    && request.resource.data.isTestOrder == true
                    && request.resource.data.paymentStatus == 'Test'
                    && request.resource.data.paymentMethod == 'Test Order (No Payment)'
                    && request.resource.data.status == 'Ordered'
                    && request.resource.data.items is list;

      // 2. Customers can only read their own orders; Admin can read all orders
      allow read: if isAdmin() || (
        request.auth != null && (
          (resource.data.userId != null && resource.data.userId == request.auth.uid) ||
          (request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
        )
      );

      // 3. Only the authenticated admin can update order status or delete orders
      allow update, delete: if isAdmin();
    }

    // Users Collection: Customer & Admin profiles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == 'customer';
      allow update: if isAdmin() || (
        request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.role == 'customer'
      );
      allow delete: if isAdmin();
    }
  }
}
