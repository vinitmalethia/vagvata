rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the authenticated user has administrative clearance
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sachin@gmail.com' ||
        request.auth.uid == 'admin_sachin_jammu_vagvat' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Orders Collection: Central synchronized order collection
    match /orders/{orderId} {
      // 1. Customers can create orders during checkout
      allow create: if request.resource.data.orderId != null
                    && request.resource.data.customerName != null
                    && request.resource.data.total is number;

      // 2. Customers can only read their own orders; Admins can read all orders
      allow read: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          (request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
        )
      );

      // 3. Only authenticated admins can update order status or delete orders
      allow update, delete: if isAdmin();
    }

    // Users Collection: Customer & Admin profiles
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
  }
}
