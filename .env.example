# ==============================================================================
# Vagvat Ayurveda - Environment Configuration
# ==============================================================================

# Razorpay Configuration (Get these from https://dashboard.razorpay.com/app/keys)
# For testing: use Key ID starting with "rzp_test_..."
# For production: use Key ID starting with "rzp_live_..."
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_RAZORPAY_KEY_ID

# Set to "true" to enable Razorpay online checkout
VITE_ENABLE_ONLINE_PAYMENTS=true

# (Optional) Allow test orders without payment in local dev / staging
VITE_ENABLE_TEST_ORDERS=false

# (Optional) Cloudflare Worker API URL if serverless payment verification is deployed
# VITE_PAYMENT_API_URL=https://api.vagvatayurveda.com

# (Optional) Cloudflare Turnstile Site Key for checkout bot protection
# VITE_CF_TURNSTILE_SITE_KEY=your_turnstile_site_key
